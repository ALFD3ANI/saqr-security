# ════════════════════════════════════════════════════════════════
# Saqr Security - متغيرات البيئة
# انسخ هذا الملف إلى .env وعبّئ القيم
# لا ترفع .env إلى GitHub أبداً!
# ════════════════════════════════════════════════════════════════

# ── المعلومات الأساسية ───────────────────────────────────────────
APP_ENV=development
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PHONE=+966xxxxxxxxx

# ── الأمان (غيّر هذه القيم!) ─────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-minimum-32-chars
ENCRYPTION_KEY=your-32-char-encryption-key-here!!
ADMIN_2FA_REQUIRED=false

# ── قاعدة البيانات ───────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://saqr:saqrpass@db:5432/saqr_db
DATABASE_URL_SYNC=postgresql://saqr:saqrpass@db:5432/saqr_db
REDIS_URL=redis://redis:6379/0

# ── الذكاء الاصطناعي (مفتاح المنصة الموحد) ──────────────────────
# احصل على مفتاحك من: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# حدود التكاليف (بالدولار)
AI_DAILY_LIMIT_USD=50
AI_MONTHLY_LIMIT_USD=1500
AI_ALERT_EMAIL=admin@your-domain.com
AI_ALERT_PHONE=+966xxxxxxxxx

# ── بوابة Moyasar للدفع ──────────────────────────────────────────
# احصل على المفاتيح من: https://moyasar.com
MOYASAR_API_KEY=sk_live_...
MOYASAR_PUBLISHABLE_KEY=pk_live_...
MOYASAR_WEBHOOK_SECRET=...

# ZATCA - الفواتير الإلكترونية
ZATCA_API_KEY=
ZATCA_VAT_NUMBER=

# ── البريد الإلكتروني ────────────────────────────────────────────
SENDGRID_API_KEY=SG...
MAIL_FROM=noreply@your-domain.com

# ── الرسائل القصيرة (Unifonic) ──────────────────────────────────
UNIFONIC_APP_SID=
UNIFONIC_SENDER=Saqr

# ── WAF Integrations ─────────────────────────────────────────────
CLOUDFLARE_API_TOKEN=
AWS_WAF_ACCESS_KEY=
AWS_WAF_SECRET_KEY=

# ── GitHub OAuth ─────────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Feature Flags ────────────────────────────────────────────────
ENABLE_AUTO_APPROVAL_LOW_RISK=false
ENABLE_AUTOFIX_ENTERPRISE=false
ENABLE_DARKWEB_MONITORING=false
ENABLE_BYOK=false
